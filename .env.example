# ==============================================================================
# DROPKIT PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your production credentials.
# In production mode (DROPKIT_ENV=production), missing secrets will block startup safely.

# Deployment Environment ('development' or 'production')
DROPKIT_ENV=development

# Core Cryptographic Secrets (Must be at least 32 characters in production)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
DROPKIT_SECRET_KEY=
DROPKIT_WEBHOOK_SECRET=

# Active Payment Provider ('razorpay', 'cashfree', or 'both')
PAYMENT_PROVIDER=both

# ------------------------------------------------------------------------------
# Razorpay Official Integration Credentials
# Sign up at: https://dashboard.razorpay.com/#/access/api-keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Cashfree Official Integration Credentials
# Sign up at: https://merchant.cashfree.com/merchants/login
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree Environment: 'sandbox' for testing, 'api' for live payments
CASHFREE_ENV=sandbox

# ------------------------------------------------------------------------------
# Merchant Dynamic UPI Details
# ------------------------------------------------------------------------------
DROPKIT_UPI_VPA=dropkit.pay@icici
DROPKIT_MERCHANT_NAME=DropKit Digital

# ------------------------------------------------------------------------------
# Initial Store Owner / Administrator Credentials
# In production, default passwords are rejected by the security validator.
# ------------------------------------------------------------------------------
DROPKIT_ADMIN_USER=admin
DROPKIT_ADMIN_PASS=

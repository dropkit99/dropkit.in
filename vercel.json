{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/checkout/(.*)", "destination": "/checkout.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/products/(.*)", "destination": "/product-detail.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/payment-status", "destination": "/payment-status.html" },
    { "source": "/my-downloads", "destination": "/my-downloads.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ]
}
